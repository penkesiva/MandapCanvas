# ─── Required in production ────────────────────────────────────────────────

# Gemini image generation — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default: gemini-2.5-flash-image (~$0.039/image, retires 2027-03-15).
# Recommended upgrade once tested: gemini-3.1-flash-image-preview (~$0.067/image at 1K).
GEMINI_IMAGE_MODEL=

# Signs session cookies and magic links. Any random string of 32+ chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of the site (used in emails, Stripe redirects, share links, OG tags)
NEXT_PUBLIC_SITE_URL=https://mandapcanvas.com

# Stripe — https://dashboard.stripe.com/apikeys (no products needed; prices are in lib/config.ts)
STRIPE_SECRET_KEY=
# Webhook endpoint: {SITE_URL}/api/stripe/webhook  — events:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   invoice.paid, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Database + image storage — Supabase. Run supabase/schema.sql once in the SQL Editor.
# Project Settings → API: Project URL and the service_role secret key (server only, never public).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternatives to Supabase (used only when SUPABASE_* is empty):
# UPSTASH_REDIS_REST_URL=   UPSTASH_REDIS_REST_TOKEN=   (database)
# BLOB_READ_WRITE_TOKEN=                                (Vercel Blob images)

# Email (magic links, "album ready", receipts) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="MandapCanvas <hello@mandapcanvas.com>"

# Protects /api/cron/* (Vercel sends it as a Bearer token automatically)
CRON_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────

# Comma-separated emails that can open /admin
ADMIN_EMAILS=
SUPPORT_EMAIL=hello@mandapcanvas.com
# Hard stop on image spend per UTC day, in cents (default 5000 = $50). Generation pauses and resumes the next day.
DAILY_COST_CAP_CENTS=5000
# Override the estimated cost per image used for margin tracking, in cents
COST_PER_IMAGE_CENTS=
# Free trial days for Pro/Studio subscriptions (blank = no trial)
PRO_TRIAL_DAYS=

# ─── Local development only ────────────────────────────────────────────────

# 1 = placeholder images instead of Gemini calls (automatic in dev when GEMINI_API_KEY is empty)
MOCK_GENERATION=
# 1 = allow the fake checkout page when STRIPE_SECRET_KEY is empty (always on in `next dev`)
ALLOW_DEV_CHECKOUT=
