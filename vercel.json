{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/advance",
      "schedule": "41 10 * * *"
    }
  ]
}
